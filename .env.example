# 이 파일을 .env 로 복사하고 키를 넣는다. .env 는 git 에 올라가지 않는다.
# 쓰는 제공자의 키 하나만 있으면 된다.
OPENAI_API_KEY=
GEMINI_API_KEY=
# 폰에서 쓸 때만 (python -m tools.run_mobile). 8자 이상. 없으면 네트워크에 열지 않는다.
